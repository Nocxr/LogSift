{
  "id": "swift-xcode-metal",
  "name": "Swift / Xcode / Metal",
  "detect": [
    "xcodebuild",
    "SwiftCompile",
    "CompileSwift",
    "SwiftEmitModule",
    ".swift:",
    "Metal",
    "MTL",
    "metallib",
    "metal-ar",
    "codesign",
    "Provisioning"
  ],
  "high_priority": [
    ": error:",
    "error: emit-module command failed",
    "SwiftEmitModule failed",
    "CompileSwift failed",
    "SwiftCompile failed",
    "Command SwiftCompile failed",
    "Command SwiftEmitModule failed",
    "Command PhaseScriptExecution failed",
    "Command CodeSign failed",
    "BUILD FAILED",
    "fatal error:",
    "Undefined symbols for architecture",
    "ld: symbol(s) not found",
    "linker command failed",
    "library not found for",
    "framework not found",
    "No such module",
    "cannot find type",
    "cannot find ",
    "ambiguous use of",
    "type of expression is ambiguous",
    "does not conform to protocol",
    "missing required module",
    "Metal compiler error",
    "failed to compile metal",
    "failed to create library",
    "MTLLibraryError",
    "MTLCompilerError",
    "CodeSign error",
    "Signing for ",
    "requires a development team",
    "No profiles for",
    "Provisioning profile"
  ],
  "warnings": [
    ": warning:",
    "warning:",
    "deprecated:",
    "will be removed",
    "Metal compiler warning"
  ],
  "questionable": [
    ": note:",
    "note:",
    "candidate",
    "required by",
    "in expansion of macro",
    "Using new build system"
  ],
  "noise": [
    "note: Using codesigning identity override:",
    "WriteAuxiliaryFile",
    "ProcessInfoPlistFile",
    "Touch ",
    "RegisterExecutionPolicyException",
    "Validate ",
    "CodeSign ",
    "builtin-infoPlistUtility",
    "builtin-SwiftStdLibTool",
    "GatherProvisioningInputs",
    "CreateBuildDescription",
    "Build description signature:",
    "Build description path:"
  ]
}
